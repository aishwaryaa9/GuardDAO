{
  "name": "guarddao",
  "version": "1.0.0",
  "description": "GuardDAO: A Secure and Risk-Aware Blockchain Governance and Treasury Management System. Secure Governance. Accountable Funding. Trusted Participation.",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat ignition deploy ./ignition/modules/Governance.js --network localhost",
    "deploy:guarddao": "hardhat ignition deploy ./ignition/modules/GuardDAO.js --network localhost",
    "sync:frontend": "node scripts/sync-frontend-deployment.js",
    "deploy:sepolia": "hardhat ignition deploy ./ignition/modules/Governance.js --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "dao",
    "governance",
    "solidity",
    "openzeppelin",
    "governor",
    "timelock",
    "erc20votes",
    "ethereum",
    "defi"
  ],
  "author": "Amalendu Suresh <amalendusuresh95@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "chai": "^4.2.0",
    "ethers": "^6.11.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5"
  }
}
